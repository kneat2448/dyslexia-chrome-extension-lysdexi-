{
  "manifest_version": 3,
  "name": "lysdexi",
  "short_name": "lysdexi",
  "description": "Offline dyslexia reading support: OpenDyslexic font, reading ruler, syllable splitting, clean reader mode and text-to-speech.",
  "version": "1.0.0",
  "minimum_chrome_version": "105",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "lysdexi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "commands": {
    "toggle-extension": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Toggle lysdexi on the current tab"
    },
    "toggle-ruler": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Toggle the reading ruler"
    },
    "speak-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Speak selected text"
    },
    "toggle-reader-mode": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Toggle clean reader mode"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/content.css"],
      "js": [
        "content/syllables.js",
        "content/speech.js",
        "content/article-detector.js",
        "content/ui-styles.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/*.ttf"],
      "matches": ["<all_urls>"]
    }
  ]
}
